{
  "name": "herdr-blaxel-sandbox-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Run coding agents in persistent Blaxel sandboxes from Herdr.",
  "type": "module",
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run verify:manifest && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "verify:manifest": "node scripts/verify-manifest.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@blaxel/core": "0.3.11",
    "string-width": "8.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "toml": "4.2.0"
  },
  "keywords": [
    "herdr",
    "herdr-plugin",
    "blaxel",
    "sandbox",
    "codex",
    "claude-code",
    "opencode",
    "pi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/blaxel-ai/herdr-blaxel-sandbox-plugin.git"
  },
  "homepage": "https://github.com/blaxel-ai/herdr-blaxel-sandbox-plugin#readme",
  "bugs": {
    "url": "https://github.com/blaxel-ai/herdr-blaxel-sandbox-plugin/issues"
  },
  "license": "MIT"
}
